# Copy to `.env` or `.env.local` and adjust. Loaded by Nest ConfigModule: `.env.local` overrides `.env`.
# See packages/integration-framework defaults in `loadIntegrationConfig` for fallback values.

# --- Nest / HTTP demo logs (both channel + upstream `main.ts`)
# Comma-separated Nest log levels (default: error,warn,log — shows bootstrap + NestLogger lines).
# NEST_LOG_LEVELS=error,warn,log
# One line per request on stdout: `[http] GET /path 200`. Set to false to silence.
# HTTP_ACCESS_LOG=false

# Use-case + idempotency store detail logs (`Logger`). Under Jest defaults to off unless you set `true`.
# APPLICATION_VERBOSE_LOGS=true

# --- Channel app (`src/contexts/channel`)
CHANNEL_PORT=3000
UPSTREAM_URL=http://127.0.0.1:3001
SERVICE_NAME=channel

# --- Upstream simulator (`src/contexts/upstream`)
UPSTREAM_PORT=3001

# --- Idempotency (channel `POST /demo/order`)
# If `REDIS_URL` is set and Redis answers `PING`, orders are deduped in Redis (keys: `assessment:channel:idempotency:*`).
# If Redis is down or unset, the app falls back to an in-memory store (same process only).
# REDIS_URL=redis://127.0.0.1:6379
# IDEMPOTENCY_REDIS_TTL_SECONDS=86400

# --- Integration framework (@assessment/integration-framework, IF_*)
IF_HTTP_TIMEOUT_MS=5000
IF_RETRY_MAX_ATTEMPTS=3
IF_RETRY_BASE_MS=50
IF_RETRY_MAX_MS=2000
IF_RETRY_JITTER_RATIO=0.25
IF_BREAKER_ERROR_THRESHOLD_PCT=50
IF_BREAKER_RESET_TIMEOUT_MS=3000
IF_BREAKER_VOLUME_THRESHOLD=5
IF_BULKHEAD_MAX_CONCURRENT=8

# --- OpenTelemetry (optional; channel `maybeBootstrapTelemetry()`)
# Disabled explicitly even if an endpoint is set:
# OTEL_ENABLED=false
# Or disable the whole SDK (standard OTEL env):
# OTEL_SDK_DISABLED=true
# OTLP HTTP when using docker-compose.demo.yml collector (port 4318):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# (You can also set the base URL `http://127.0.0.1:4318` — the app appends `/v1/traces`.)
# OTEL_SERVICE_NAME=channel
# The channel entrypoint loads `.env` / `.env.local` in `otel-register.ts` **before** the SDK starts (Nest’s ConfigModule loads later).
# Uncomment and set the OTLP lines below for Jaeger to show a second service (e.g. `channel`), not only `jaeger-all-in-one`.

# --- Reliability harness only (`src/test/reliability-test.ts`; spawned processes inject their own IF_*)
# RELIABILITY_UPSTREAM_PORT=43100
# RELIABILITY_CHANNEL_PORT=43101
# RELIABILITY_RECOVERY_MS=1800
# RELIABILITY_USE_DIST=1

# NODE_ENV=development
