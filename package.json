{
  "name": "technical-lead-practical-assessment",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "prebuild": "pnpm integration-framework:build",
    "build": "tsc -p tsconfig.build.json",
    "start:channel": "node dist/contexts/channel/main.js",
    "start:upstream": "node dist/contexts/upstream/main.js",
    "prestart:dev:upstream": "pnpm integration-framework:build",
    "start:dev:upstream": "node --loader ts-node/esm src/contexts/upstream/main.ts",
    "prestart:dev:channel": "pnpm integration-framework:build",
    "start:dev:channel": "node --loader ts-node/esm src/contexts/channel/main.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "integration-framework:build": "pnpm --filter @assessment/integration-framework build",
    "test:reliability": "pnpm integration-framework:build && node --loader ts-node/esm src/test/reliability-test.ts",
    "openapi:generate": "pnpm integration-framework:build && node --loader ts-node/esm src/scripts/generate-openapi.ts",
    "postman:generate": "node --loader ts-node/esm src/scripts/generate-postman.ts",
    "docs:api": "pnpm openapi:generate && pnpm postman:generate",
    "demo:up": "docker compose -f docker-compose.demo.yml up -d",
    "demo:down": "docker compose -f docker-compose.demo.yml down",
    "demo:config": "docker compose -f docker-compose.demo.yml config",
    "sdd:start": "echo \"Run /specs -> /plan -> /architecture -> /implementation in Cursor.\"",
    "sdd:review": "echo \"Run /review in Cursor and verify docs/evidence/review-agent-evidence.md.\""
  },
  "dependencies": {
    "@assessment/integration-framework": "workspace:*",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/swagger": "^11.4.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.52.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/sdk-node": "^0.57.2",
    "fastify": "^5.6.1",
    "opossum": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@jest/globals": "^30.4.1",
    "@nestjs/testing": "^11.1.19",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.18",
    "@types/opossum": "^8.1.9",
    "eslint": "^9.18.0",
    "globals": "^15.15.0",
    "jest": "^30.4.1",
    "openapi-to-postmanv2": "^6.0.1",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  }
}
